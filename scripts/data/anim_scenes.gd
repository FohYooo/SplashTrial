extends RefCounted
## Animated story scenes, played with the story command `@anim <id>` (scripts/ui/story_anim.gd).
## tools/check_content.py checks every id a script uses and every beat below; tools/check_depth.py checks how often
## a case has one. Debug: Godot --path . -- --anim=<id> [--anim-t=<seconds> --shot=<png>]
##
## A scene: {"format", "length" (seconds), "beats": [[time, kind, {args}], ...]} plus optional overrides of the
## format's "in", "out", "letterbox", "tape" and "music". Plain data only (numbers, strings, arrays), so the
## checkers can read it. Positions are 1280x720 screen pixels; [x, y] for points, [x, y, w, h] for rects.
## Colours: a cast id, aqua / gold / yuzu / danger / violet / good / ink / white, or "#rrggbb".
## Eases: linear, sine, out, in, expo, back, expo_in. Art: an art/bg id or an art/props id.
##
## Beat kinds (required args in KINDS):
##   stage    bg {art, layer, tint}   clear {keep_bg, wash}   wash {col, a, dur, all}
##            actor {id, char + expr | art, x, y, s, rot, layer, flip, from, dur, ease, anchor, bob, shadow, tint, sil, a}
##              layers: far, back, mid, front (camera, with parallax), over (screen, above the cut-ins so far), top
##            glow {id, at, r, col, a, layer, from_a, dur}   move {id, to, s, rot, a, dur, ease}
##            expr {id, char, expr, hop}   hop {id, h, dur}   shudder {id, amt, dur}   out {id, dur, to}
##   camera   cam {at, z, roll, dur, ease, drift}   punch {at, k, dur}   letterbox {on, dur}
##   impact   hit {s, flash, col, lines, glitch, sfx, p, v, stop, invert}   shake {s}   rumble {s, dur}
##            flash {col, a, dur}   glitch {dur, amt}   speed {at, dur, col, n, inner}   blade {a, b, col, w}
##            hitstop {dur, invert}   splash {at, col, n, r, dur}   shatter {at, dur}
##            burst {at, kind: drop|puff|chip|confetti, cols, n, spd, size, g, life, spread, aim, grow, w, a, drag}
##   cut-ins  panel {id, char, expr, rect, skew, col, from, zoom, tag, line, line_above, bang, slab, kick}   slab {id, dur}
##            slam {id, text, char, expr, col, small, yell, tag, rot, fs, sfx}   title {id, text, sub, col, rot, fs, sfx}
##            badge {id, title, tab, sub, col, at}   pop {id, text, at, fs, col, edge, rot, plate, plate_col, top, dur, inflate, in, max_w}
##            say {who, text, dur, y}
##   tape     onair {title, col}   ticker {text, col, tag, speed, y}   price {id, was, now, at, col, r, strike, sfx}
##            vhs {static, tear, chroma, desat, grain, tracking, vignette, bright, dur, on}   crt {to, dur}
##   other    sfx {id, p, v}   music {id, fade}   wipe {to, dur}   jaw {to, dur, ease}
## Element ids starting with "_" are reserved for the player.

## Lengths are the plan's (docs: depth-and-case3-plan.md, section 1.6). "in"/"out": wipe, cut, tv, jaw (out only).
const FORMATS := {
	"slam": {"min": 6.0, "max": 12.0, "in": "cut", "out": "wipe", "skip_after": 0.8, "letterbox": false, "tape": false},
	"cutout": {"min": 15.0, "max": 35.0, "in": "wipe", "out": "wipe", "skip_after": 1.5, "letterbox": true, "tape": false},
	"broadcast": {"min": 20.0, "max": 30.0, "in": "tv", "out": "tv", "skip_after": 1.5, "letterbox": false, "tape": true, "music": "an_jingle"},
	"full": {"min": 45.0, "max": 60.0, "in": "wipe", "out": "wipe", "skip_after": 2.0, "letterbox": true, "tape": false},
}

const KINDS := {
	"bg": ["art"], "clear": [], "wash": [], "actor": ["id"], "glow": ["id"], "move": ["id"], "expr": ["id", "char", "expr"],
	"hop": ["id"], "shudder": ["id"], "out": ["id"], "cam": [], "punch": [], "letterbox": [], "hit": [], "shake": [],
	"rumble": [], "flash": [], "glitch": [], "speed": [], "blade": [], "hitstop": [], "splash": [], "shatter": [], "burst": [],
	"panel": ["id", "char", "rect"], "slab": ["id"], "slam": ["id", "text"], "title": ["id", "text"], "badge": ["id", "title"],
	"pop": ["id", "text"], "say": ["text"], "onair": [], "ticker": ["text"], "price": ["id", "was", "now"], "vhs": [],
	"crt": [], "sfx": ["id"], "music": ["id"], "wipe": [], "jaw": [],
}

